  "homepage": "https://github.com/Nikais/git-companion",
  "repository": "https://github.com/Nikais/git-companion",
  "keywords": [
    "git",
    "codex",
    "mcp",
    "code-review"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Git Companion",
        "shortDescription": "Local Git tools and workflows for AI coding agents",
        "category": "Coding",
        "websiteURL": "https://github.com/Nikais/git-companion",
        "capabilities": [
          "Read",
          "Write"
        ]
      }
    }
  }
}
